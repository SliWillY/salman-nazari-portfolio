---
import { getCollection } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import Section from '../../blocks/Section.astro';
import type { BlockContext } from '../../blocks/types';
import { section as sectionSchema } from '../../lib/content-schemas';
import { langs, t, type Lang } from '../../lib/i18n';
import { resolveSections } from '../../lib/prefabs';

export async function getStaticPaths() {
  const pages = await getCollection('pages');
  return pages.flatMap((page) => langs.map((lang) => ({
    params: { lang, slug: page.id === 'home' ? undefined : page.id },
    props: { page }
  })));
}

const { page } = Astro.props;
const lang = Astro.params.lang as Lang;
const { data } = page;
const ctx: BlockContext = { lang, route: page.id, title: data.title, description: data.description, eyebrow: data.eyebrow };
const sections = await resolveSections(data, `src/content/pages/${page.id}.yaml`);
if (data.header === 'auto') sections.unshift({ ...sectionSchema.parse({ spacing: 's' }), blocks: [{ type: 'hero', size: 'page' }] });
---
<BaseLayout lang={lang} title={t(data.title, lang)} description={t(data.description, lang)} currentSlug={page.id} home={page.id === 'home'}>
  {sections.map((section) => <Section section={section} lang={lang} ctx={ctx} />)}
</BaseLayout>
