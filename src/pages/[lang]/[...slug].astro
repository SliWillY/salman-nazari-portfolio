---
import { getCollection, render } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import MediaBlock from '../../components/MediaBlock.astro';
import CloudinaryImage from '../../components/CloudinaryImage.astro';
import { path, type Lang } from '../../lib/site';

export async function getStaticPaths() {
  const pages = await getCollection('pages');
  return pages.map((page) => ({ params: { lang: page.data.lang, slug: page.data.route === 'home' ? undefined : page.data.route }, props: { page } }));
}

const { page } = Astro.props;
const { Content } = await render(page);
const { lang, route: slug, title, description, kind, eyebrow, heroImage, featured, media, links } = page.data;
---
<BaseLayout lang={lang as Lang} title={title} description={description} currentSlug={slug} home={kind === 'home'}>
  {kind === 'home' ? (
    <div class="home-content">
      <section class="home-hero"><div><span class="eyebrow">{eyebrow}</span><h1>{title}</h1><p>{description}</p></div></section>
      <section class="home-grid" aria-label="Featured work">{featured.map((item) => <a class="feature-card" href={path(`/${lang}/${item.href}/`)}><div>{item.image && <CloudinaryImage publicId={item.image} alt="" width={720} />}<h2>{item.title}</h2><p>{item.text}</p></div><span class="feature-link">{lang === 'ar' ? 'استكشف ↗' : 'Explore ↗'}</span></a>)}</section>
    </div>
  ) : (
    <article class="page-shell"><header class="page-header"><span class="eyebrow">{eyebrow}</span><h1>{title}</h1><p>{description}</p></header><div class="prose"><Content /></div>{links.length > 0 && <div class="link-list">{links.map((link) => <a class="text-link" href={link.href} target="_blank" rel="noreferrer">{link.label} ↗</a>)}</div>}{heroImage && <div class="media-grid"><MediaBlock item={{ type: 'image', publicId: heroImage, alt: title }} /></div>}{media.length > 0 && <div class="media-grid">{media.map((item) => <MediaBlock item={item} />)}</div>}</article>
  )}
</BaseLayout>


