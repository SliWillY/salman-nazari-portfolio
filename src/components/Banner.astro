---
// Page-top banner (the page hero's picture): a sun gradient in the page's colours under the floating glass header,
// with 3D paper confetti drifting in it (StageToys.astro). On a world's own page it is tall and that world's toys
// float in it too; About and Certificates (medium) and projects (slim) have the confetti only.
// The eyebrow sits on it as a frosted-glass pill. Styles: global.css, "stage".
import type { Hue } from '../lib/site';
const { world, size = 'slim', eyebrow, eyebrowHref } = Astro.props as { world?: Hue; size?: 'tall' | 'medium' | 'slim'; eyebrow?: string; eyebrowHref?: string };
---
<div class:list={['page-banner', `is-${size}`]} data-toys={world ?? ''}>
  <canvas class="stage-canvas" aria-hidden="true"></canvas>
  {eyebrow && (eyebrowHref
    ? <a class="eyebrow banner-eyebrow" href={eyebrowHref}>{eyebrow}</a>
    : <span class="eyebrow banner-eyebrow">{eyebrow}</span>)}
</div>
