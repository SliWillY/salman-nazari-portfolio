---
import Wordmark from './Wordmark.astro';
import { nav, labels, themeLabels, path, categoryHue, pageNumber, type Lang } from '../lib/site';
const { lang, currentSlug } = Astro.props as { lang: Lang; currentSlug: string };
const t = labels[lang];
const hrefFor = (target: Lang) => path(currentSlug === 'home' ? `/${target}/` : `/${target}/${currentSlug}/`);
const isActive = (slug: string) => currentSlug === slug || currentSlug.startsWith(`${slug}/`);
const languages = [{ code: 'en' as Lang, label: 'EN', name: 'English' }, { code: 'ar' as Lang, label: 'ع', name: 'العربية' }];
const target = languages.find((l) => l.code !== lang)!;
---
<a class="skip-link" href="#main">{t.skip}</a>
<!-- Always laid out left-to-right so wordmark, menu and language switch stay put when switching languages. -->
<header class="site-header" dir="ltr" data-header>
  <div class="site-header-inner">
    <Wordmark lang={lang} />

    <nav class="primary-nav" id="primary-nav" aria-label={t.nav} data-nav>
      {/* The bar stays left-to-right, but the menu itself reads in the page's direction: in Arabic it starts from the right. */}
      <ul dir={lang === 'ar' ? 'rtl' : 'ltr'}>
        {nav.map((item) => (
          <li><a class:list={[categoryHue[item.slug] ? `hue-${categoryHue[item.slug]}` : pageNumber(item.slug) && 'hue-brand']} href={path(`/${lang}/${item.slug}/`)} aria-current={isActive(item.slug) ? 'page' : undefined} lang={lang} dir="auto">{item[lang]}{pageNumber(item.slug) && <sup class="nav-num" aria-hidden="true">{pageNumber(item.slug)}</sup>}</a></li>
        ))}
      </ul>
    </nav>

    <div class="header-actions">
      <!-- Cycles the saved theme; the label is filled in by the script below, the icon by CSS from <html data-theme>. -->
      <button class="theme-toggle" type="button" aria-label={themeLabels[lang].name} data-theme-toggle data-labels={JSON.stringify(themeLabels[lang])}>
        <svg class="theme-icon theme-icon-light" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" aria-hidden="true" focusable="false"><circle cx="12" cy="12" r="4" /><path d="M12 2.5v2M12 19.5v2M2.5 12h2M19.5 12h2M5.3 5.3l1.4 1.4M17.3 17.3l1.4 1.4M5.3 18.7l1.4-1.4M17.3 6.7l1.4-1.4" /></svg>
        <svg class="theme-icon theme-icon-dark" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" focusable="false"><path d="M20.5 14.2A8.5 8.5 0 1 1 9.8 3.5a6.8 6.8 0 0 0 10.7 10.7Z" /></svg>
        <svg class="theme-icon theme-icon-system" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" focusable="false"><rect x="3" y="4" width="18" height="12.5" rx="2" /><path d="M12 4v12.5" /><path d="M12 4h7a2 2 0 0 1 2 2v8.5a2 2 0 0 1-2 2h-7Z" fill="currentColor" stroke="none" /><path d="M8.5 20.5h7M12 16.5v4" /></svg>
      </button>
      <!-- The whole pill is one link to the other language, so it can be tapped anywhere. -->
      <a class="lang-switch" href={hrefFor(target.code)} hreflang={target.code} title={target.name}>
        {languages.map((l) => <span class:list={['lang-option', { 'is-current': l.code === lang }]} lang={l.code} aria-hidden="true">{l.label}</span>)}
        <span class="sr-only" lang={target.code}>{target.name}</span>
      </a>
      <button class="menu-toggle" type="button" aria-expanded="false" aria-controls="primary-nav" data-menu-toggle data-open-label={t.menu} data-close-label={t.close} aria-label={t.menu}>
        <span class="menu-icon" aria-hidden="true"><span></span><span></span></span>
      </button>
    </div>
  </div>
</header>

<script>
  const header = document.querySelector<HTMLElement>('[data-header]')!;
  const toggle = header.querySelector<HTMLButtonElement>('[data-menu-toggle]')!;
  const nav = header.querySelector<HTMLElement>('[data-nav]')!;
  const outside = () => [document.querySelector('main'), document.querySelector('.site-footer'), document.querySelector('.skip-link')].filter(Boolean) as HTMLElement[];

  // Open mobile menu behaves like a modal: page behind is inert, focus moves into the menu.
  const setOpen = (open: boolean) => {
    header.toggleAttribute('data-menu-open', open);
    document.documentElement.classList.toggle('menu-locked', open);
    outside().forEach((el) => (el.inert = open));
    toggle.setAttribute('aria-expanded', String(open));
    toggle.setAttribute('aria-label', (open ? toggle.dataset.closeLabel : toggle.dataset.openLabel) ?? '');
    if (open) nav.querySelector<HTMLAnchorElement>('a')?.focus();
  };
  const isOpen = () => header.hasAttribute('data-menu-open');

  toggle.addEventListener('click', () => setOpen(!isOpen()));
  nav.addEventListener('click', (event) => { if ((event.target as HTMLElement).closest('a')) setOpen(false); });
  document.addEventListener('keydown', (event) => {
    if (!isOpen()) return;
    if (event.key === 'Escape') { setOpen(false); toggle.focus(); return; }
    if (event.key !== 'Tab') return;
    // Keep Tab cycling inside the header (wordmark, theme toggle, menu links, language switch, close button).
    const items = [...header.querySelectorAll<HTMLElement>('a[href], button')];
    const first = items[0];
    const last = items[items.length - 1];
    if (event.shiftKey && document.activeElement === first) { event.preventDefault(); last.focus(); }
    else if (!event.shiftKey && document.activeElement === last) { event.preventDefault(); first.focus(); }
  });
  matchMedia('(min-width: 1121px)').addEventListener('change', (event) => { if (event.matches && isOpen()) setOpen(false); });

  // Theme: 'light' | 'dark' | 'system', saved in localStorage ('system' = nothing saved).
  // The inline script in BaseLayout applies the saved value before first paint; this keeps it in sync afterwards.
  type Theme = 'light' | 'dark' | 'system';
  const root = document.documentElement;
  const themeToggle = header.querySelector<HTMLButtonElement>('[data-theme-toggle]')!;
  const themeText = JSON.parse(themeToggle.dataset.labels ?? '{}') as Record<string, string>;
  const osDark = matchMedia('(prefers-color-scheme: dark)');
  const parse = (value: unknown): Theme => (value === 'light' || value === 'dark' ? value : 'system');
  const current = () => parse(root.dataset.theme);
  // The first click always flips what's on screen: system → the other theme → the OS theme → system.
  const nextTheme = (theme: Theme): Theme => {
    const os = osDark.matches ? 'dark' : 'light';
    const other = os === 'dark' ? 'light' : 'dark';
    return theme === 'system' ? other : theme === other ? os : 'system';
  };
  const updateLabel = () => {
    const theme = current();
    const label = themeText.template.replace('{current}', themeText[theme]).replace('{next}', themeText[nextTheme(theme)]);
    themeToggle.setAttribute('aria-label', label);
    themeToggle.title = label;
  };
  let transitionTimer = 0;
  const applyTheme = (theme: Theme, animate: boolean) => {
    // .theme-transition eases colours for one switch only (CSS skips it under reduced motion).
    if (animate) {
      root.classList.add('theme-transition');
      clearTimeout(transitionTimer);
      transitionTimer = window.setTimeout(() => root.classList.remove('theme-transition'), 300);
    }
    root.dataset.theme = theme;
    root.style.colorScheme = theme === 'system' ? '' : theme;
    for (const meta of document.querySelectorAll<HTMLMetaElement>('meta[name="theme-color"]')) {
      meta.content = meta.dataset[theme === 'system' ? meta.dataset.scheme! : theme] ?? meta.content;
    }
    updateLabel();
  };

  themeToggle.addEventListener('click', () => {
    const theme = nextTheme(current());
    applyTheme(theme, true);
    try { theme === 'system' ? localStorage.removeItem('theme') : localStorage.setItem('theme', theme); } catch {}
  });
  // Keep other open tabs in step, and relabel when the OS theme changes (it changes what "next" means).
  addEventListener('storage', (event) => { if (event.key === 'theme' || event.key === null) applyTheme(parse(event.newValue), true); });
  osDark.addEventListener('change', updateLabel);
  updateLabel();

  // Border + shadow once the page scrolls under the sticky bar.
  const onScroll = () => header.toggleAttribute('data-scrolled', window.scrollY > 8);
  addEventListener('scroll', onScroll, { passive: true });
  onScroll();
</script>
