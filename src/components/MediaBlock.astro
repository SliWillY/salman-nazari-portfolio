---
import CloudinaryImage from './CloudinaryImage.astro';
import { cloudinaryUrl, normalizePublicId } from '../lib/cloudinary';
const { item, lang = 'en' } = Astro.props;
const aspect = item.aspect ?? '16 / 9';
const cloud = import.meta.env.PUBLIC_CLOUDINARY_CLOUD_NAME || 'vwkbtzdh';
const docLabel = lang === 'ar' ? 'عرض المستند' : 'Open document';
const docUrl = item.url || (item.publicId ? cloudinaryUrl(item.publicId) : undefined);
const videoId = item.id || item.publicId;
---
<figure class="media-block" style={`--media-aspect: ${aspect}`}>
  {item.type === 'image' && item.publicId && <CloudinaryImage publicId={item.publicId} alt={item.alt ?? item.title ?? ''} />}
  {item.type === 'video' && item.provider === 'cloudinary' && videoId && (
    <video
      controls
      preload="metadata"
      playsinline
      title={item.title ?? 'Video'}
      src={`https://res.cloudinary.com/${cloud}/video/upload/q_auto,f_auto/${normalizePublicId(videoId)}.mp4`}
    />
  )}
  {item.type === 'video' && (item.provider === 'youtube' || item.provider === 'vimeo') && item.id && (
    <iframe
      src={item.provider === 'vimeo' ? `https://player.vimeo.com/video/${item.id}` : `https://www.youtube.com/embed/${item.id}`}
      title={item.title ?? 'Embedded video'}
      loading="lazy"
      allow="accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture"
      allowfullscreen
    />
  )}
  {item.type === 'document' && docUrl && (
    <div class="document-card"><span class="document-icon" aria-hidden="true">↗</span><div><strong>{item.title}</strong><a href={docUrl} target="_blank" rel="noreferrer">{docLabel}</a></div></div>
  )}
  {item.type === 'link' && item.url && <a class="external-card" href={item.url} target="_blank" rel="noreferrer"><span>{item.title}</span><span aria-hidden="true">↗</span></a>}
  {item.caption && <figcaption>{item.caption}</figcaption>}
</figure>
