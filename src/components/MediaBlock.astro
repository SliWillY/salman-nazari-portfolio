---
import CloudinaryImage from './CloudinaryImage.astro';
const { item } = Astro.props;
const aspect = item.aspect ?? '16 / 9';
---
<figure class="media-block" style={`--media-aspect: ${aspect}`}>
  {item.type === 'image' && item.publicId && <CloudinaryImage publicId={item.publicId} alt={item.alt ?? item.title ?? ''} />}
  {item.type === 'video' && item.provider && item.id && (
    <iframe
      src={item.provider === 'vimeo' ? `https://player.vimeo.com/video/${item.id}` : `https://www.youtube.com/embed/${item.id}`}
      title={item.title ?? 'Embedded video'}
      loading="lazy"
      allow="accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture"
      allowfullscreen
    />
  )}
  {item.type === 'document' && item.url && (
    <div class="document-card"><span class="document-icon" aria-hidden="true">↗</span><div><strong>{item.title}</strong><a href={item.url} target="_blank" rel="noreferrer">Open document</a></div></div>
  )}
  {item.type === 'link' && item.url && <a class="external-card" href={item.url} target="_blank" rel="noreferrer"><span>{item.title}</span><span aria-hidden="true">↗</span></a>}
  {item.caption && <figcaption>{item.caption}</figcaption>}
</figure>
