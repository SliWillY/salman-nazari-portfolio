---
// A slider's previous / next button (gallery and PDF sliders; paging in Slider.astro). A drawn arrow, not a text
// glyph, so it looks the same everywhere; CSS mirrors it in Arabic. Styles: global.css, .gallery-btn.
const { dir, label } = Astro.props as { dir: -1 | 1; label: string };
const paths = dir === -1 ? ['M19 12H5', 'm11 18-6-6 6-6'] : ['M5 12h14', 'm13 6 6 6-6 6'];
---
<button type="button" class="gallery-btn" data-dir={dir} aria-label={label}>
  <svg viewBox="0 0 24 24" aria-hidden="true" focusable="false">{paths.map((d) => <path d={d} />)}</svg>
</button>
