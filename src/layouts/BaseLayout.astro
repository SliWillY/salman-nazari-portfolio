---
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import StageToys from '../components/StageToys.astro';
import Analytics from '../components/Analytics.astro';
import SocialMeta from '../components/SocialMeta.astro';
import { path, themeColor, type Hue, type Lang } from '../lib/site';
import '../styles/global.css';
// hue: the world this page belongs to (category pages and their projects): its colour leads the page.
const { lang, title, description, currentSlug, home = false, hue } = Astro.props as { lang: Lang; title: string; description: string; currentSlug: string; home?: boolean; hue?: Hue };
const dir = lang === 'ar' ? 'rtl' : 'ltr';
const fullTitle = `${title} · Salman Nazari`;
---
<!doctype html>
<!-- Text direction lives on the .page wrapper, not <html>/<body>: browsers take the page
     scrollbar's side from those, so keeping them LTR pins the scrollbar to the right in both
     languages and switching language doesn't shift the layout. -->
<html lang={lang} dir="ltr">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <Analytics />
    <meta name="description" content={description} />
    <SocialMeta lang={lang} title={fullTitle} description={description} url={Astro.url.pathname} />
    <link rel="icon" type="image/svg+xml" href={path("favicon.svg")} />
    <meta name="color-scheme" content="light dark" />
    <meta name="theme-color" media="(prefers-color-scheme: light)" content={themeColor.light} data-light={themeColor.light} data-dark={themeColor.dark} />
    <meta name="theme-color" media="(prefers-color-scheme: dark)" content={themeColor.dark} data-light={themeColor.light} data-dark={themeColor.dark} />
    <!-- The one place the theme is decided, before first paint (no flash). <html data-theme> is the visitor's choice
         (light, dark or system: the toggle's icon reads it); <html data-scheme> is what is on screen (light or dark),
         the only thing the CSS reads. On "system" it follows the OS, live. The toggle in Header.astro calls
         window.applyTheme(). -->
    <script is:inline>
      (() => {
        const root = document.documentElement;
        const osDark = matchMedia('(prefers-color-scheme: dark)');
        const resolve = () => {
          const theme = root.dataset.theme;
          const scheme = theme === 'light' || theme === 'dark' ? theme : osDark.matches ? 'dark' : 'light';
          if (root.dataset.scheme === scheme) return; // unchanged: nothing to repaint (the toys relight on a change)
          root.dataset.scheme = scheme;
          for (const meta of document.querySelectorAll('meta[name="theme-color"]')) meta.content = meta.dataset[scheme];
        };
        window.applyTheme = (theme) => { root.dataset.theme = theme; resolve(); };
        let saved = 'system';
        try { const value = localStorage.getItem('theme'); if (value === 'light' || value === 'dark') saved = value; } catch {}
        window.applyTheme(saved);
        osDark.addEventListener('change', resolve);
      })();
    </script>
    <title>{fullTitle}</title>
  </head>
  <body class:list={{ 'home-page': home }}>
    <div class:list={['page', hue && `hue-${hue}`]} dir={dir} data-page>
      <Header lang={lang} currentSlug={currentSlug} />
      <main id="main" tabindex="-1"><slot /></main>
      <Footer lang={lang} />
      <StageToys />
    </div>
  </body>
</html>
