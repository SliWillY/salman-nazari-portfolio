---
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import { path, themeColor } from '../lib/site';
import '../styles/global.css';
const { lang, title, description, currentSlug, home = false } = Astro.props;
const dir = lang === 'ar' ? 'rtl' : 'ltr';
---
<!doctype html>
<!-- Text direction lives on the .page wrapper, not <html>/<body>: browsers take the page
     scrollbar's side from those, so keeping them LTR pins the scrollbar to the right in both
     languages and switching language doesn't shift the layout. -->
<html lang={lang} dir="ltr">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    {import.meta.env.PROD && (
      <Fragment>
        <!-- Google tag (gtag.js). Production builds only, so local dev visits aren't counted. -->
        <script is:inline async src="https://www.googletagmanager.com/gtag/js?id=G-B5MPLJRW2E"></script>
        <script is:inline>
          window.dataLayer = window.dataLayer || [];
          function gtag(){dataLayer.push(arguments);}
          gtag('js', new Date());

          gtag('config', 'G-B5MPLJRW2E');
        </script>
      </Fragment>
    )}
    <meta name="description" content={description} />
    <link rel="icon" type="image/svg+xml" href={path("favicon.svg")} />
    <meta name="color-scheme" content="light dark" />
    <meta name="theme-color" media="(prefers-color-scheme: light)" content={themeColor.light} data-scheme="light" data-light={themeColor.light} data-dark={themeColor.dark} />
    <meta name="theme-color" media="(prefers-color-scheme: dark)" content={themeColor.dark} data-scheme="dark" data-light={themeColor.light} data-dark={themeColor.dark} />
    <!-- Runs before first paint so the saved theme applies without a flash. Mirrors applyTheme() in Header.astro. -->
    <script is:inline>
      (() => {
        let theme = 'system';
        try { const saved = localStorage.getItem('theme'); if (saved === 'light' || saved === 'dark') theme = saved; } catch {}
        const root = document.documentElement;
        root.dataset.theme = theme;
        if (theme !== 'system') {
          root.style.colorScheme = theme;
          for (const meta of document.querySelectorAll('meta[name="theme-color"]')) meta.content = meta.dataset[theme];
        }
      })();
    </script>
    <title>{title} · Salman Nazari</title>
  </head>
  <body class:list={{ 'home-page': home }}>
    <div class="page" dir={dir} data-page>
      <Header lang={lang} currentSlug={currentSlug} />
      <main id="main" tabindex="-1"><slot /></main>
      <Footer lang={lang} />
    </div>
  </body>
</html>
