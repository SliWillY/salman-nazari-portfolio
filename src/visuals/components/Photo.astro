---
// One photo at a fixed ratio, cropped to fill it. Without a public ID yet, a grey box of the same shape stands in,
// marked with its ratio in the bottom corner at the end of the line (left). The mark's own text reads left to right
// inside a <bdi>, so its box keeps the page's direction and the corner stays on the left. A parent can change the ratio at a breakpoint with `.wrapper :global(.photo)`.
// reveal: the photo's place in a staggered wipe as it scrolls into view (visuals.css, Motion); left out, no wipe.
import { cloudinarySrcSet, cloudinaryUrl } from '../../lib/cloudinary';
import type { Photo } from '../content';

interface Props {
  photo: Photo;
  ratio: string; // '4:5', '1:1', '16:9'
  sizes: string;
  eager?: boolean; // the first photo on the page: load it at once
  label?: string; // the stand-in's mark when a parent changes the ratio; default: the ratio
  reveal?: number;
}

const { photo, ratio, sizes, eager = false, label = ratio, reveal } = Astro.props;
// A photo without words would reach screen readers and image search as nothing at all.
if (photo.id && !photo.alt.trim()) throw new Error(`visuals: the photo ${photo.id} needs its alt text in content.ts`);
const style = `--ratio: ${ratio.replace(':', ' / ')}${reveal === undefined ? '' : `; --i: ${reveal}`}`;
---
<div
  class:list={['photo', !photo.id && 'placeholder']}
  style={style}
  data-reveal={reveal === undefined ? undefined : 'wipe'}
  aria-hidden={photo.id ? undefined : 'true'}
>
  {photo.id ? (
    <img
      src={cloudinaryUrl(photo.id, 1024)}
      srcset={cloudinarySrcSet(photo.id)}
      sizes={sizes}
      alt={photo.alt}
      loading={eager ? 'eager' : 'lazy'}
      fetchpriority={eager ? 'high' : undefined}
      decoding="async"
    />
  ) : (
    <span><bdi dir="ltr">{label}</bdi></span>
  )}
</div>

<style>
  .photo { position: relative; width: 100%; aspect-ratio: var(--ratio); overflow: hidden; background: var(--placeholder); }
  img { width: 100%; height: 100%; object-fit: cover; }
  span { position: absolute; bottom: 6px; inset-inline-end: 8px; font-size: 10px; line-height: 14px; color: var(--muted); }

  /* A slow push in on hover, inside the frame. */
  @media (hover: hover) and (prefers-reduced-motion: no-preference) {
    img { transition: transform 1.2s var(--ease); }
    .photo:hover img { transform: scale(1.04); }
  }
</style>
