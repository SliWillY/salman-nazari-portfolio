---
// A section's heading row: the title in light weight and a small count at the other end, over a hairline. As it
// scrolls in, the hairline is drawn and the title and count rise.
interface Props {
  id: string; // the section's aria-labelledby points here
  heading: string;
  count?: string;
}

const { id, heading, count } = Astro.props;
---
<div class="head" data-reveal="line">
  <h2 id={id} data-reveal="rise" style="--rise: 0.5em">{heading}</h2>
  {count && <span dir="ltr" data-reveal="rise" style="--i: 2">{count}</span>}
</div>

<style>
  .head {
    position: relative;
    display: flex;
    align-items: flex-end;
    justify-content: space-between;
    padding: 24px var(--gutter) 13px;
  }
  .head::after { content: ''; position: absolute; inset-inline: 0; bottom: 0; height: 1px; background: var(--line); }
  h2 { font-size: 32px; line-height: 40px; font-weight: 300; }
  span { font-size: 12px; line-height: 16px; }

  @media (min-width: 720px) {
    .head { padding-top: 48px; }
    h2 { font-size: 48px; line-height: 60px; }
  }
</style>
