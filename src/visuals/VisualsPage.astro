---
// The visuals page: its own document, not a BaseLayout page, so none of the portfolio's header, footer, theme or
// styles come with it. Arabic only. The sections run in the order below; their words and media are in content.ts.
import { cloudinaryUrl } from '../lib/cloudinary';
import { visuals } from './content';
import './visuals.css';
import Header from './sections/Header.astro';
import Hero from './sections/Hero.astro';
import Marquee from './sections/Marquee.astro';
import Work from './sections/Work.astro';
import Angles from './sections/Angles.astro';
import BeforeAfter from './sections/BeforeAfter.astro';
import Brands from './sections/Brands.astro';
import Process from './sections/Process.astro';
import Film from './sections/Film.astro';
import Contact from './sections/Contact.astro';
import Footer from './sections/Footer.astro';

// The portfolio's GA4 property: visits show up there under /visuals/. To count them on their own, put another ID here.
const analyticsId = 'G-B5MPLJRW2E';
const url = new URL(Astro.url.pathname, Astro.site).href;
const shareImage = visuals.shareImage && cloudinaryUrl(visuals.shareImage, 1200, 'auto', 'jpg');
const base = import.meta.env.BASE_URL.replace(/\/$/, '');
---
<!doctype html>
<html lang="ar" dir="rtl">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <!-- Motion is on only when scripts run (visuals.css, Motion); set before first paint so nothing flashes. -->
    <script is:inline>document.documentElement.classList.add('js');</script>
    <title>{visuals.title}</title>
    <meta name="description" content={visuals.description} />
    <link rel="canonical" href={url} />
    <meta name="theme-color" content="#F2F2F2" />
    <!-- The portfolio's icon until visuals has its own. -->
    <link rel="icon" type="image/svg+xml" href={`${base}/favicon.svg`} />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=IBM+Plex+Sans+Arabic:wght@300;400;500&display=swap" />
    <meta property="og:type" content="website" />
    <meta property="og:locale" content="ar_AR" />
    <meta property="og:title" content={visuals.title} />
    <meta property="og:description" content={visuals.description} />
    <meta property="og:url" content={url} />
    {shareImage && <meta property="og:image" content={shareImage} />}
    <meta name="twitter:card" content={shareImage ? 'summary_large_image' : 'summary'} />
    {import.meta.env.PROD && (
      <Fragment>
        <script is:inline async src={`https://www.googletagmanager.com/gtag/js?id=${analyticsId}`}></script>
        <script is:inline define:vars={{ analyticsId }}>
          window.dataLayer = window.dataLayer || [];
          function gtag(){dataLayer.push(arguments);}
          gtag('js', new Date());
          gtag('config', analyticsId);
        </script>
      </Fragment>
    )}
  </head>
  <body>
    <div class="page">
      <Header />
      <main>
        <Hero />
        <Marquee />
        <Work />
        <Angles />
        <BeforeAfter />
        <Brands />
        <Process />
        <Film />
        <Contact />
      </main>
      <Footer />
    </div>
    <script>
      // Reveals (visuals.css, Motion): mark each element the first time it comes into view; CSS does the moving.
      // The bottom tenth of the screen doesn't count yet, so things start just after they appear.
      const observer = new IntersectionObserver((entries) => {
        for (const entry of entries) {
          if (!entry.isIntersecting) continue;
          entry.target.classList.add('is-in');
          observer.unobserve(entry.target);
        }
      }, { rootMargin: '0px 0px -10% 0px' });
      document.querySelectorAll('[data-reveal], [data-lines]').forEach((element) => observer.observe(element));
    </script>
  </body>
</html>
