---
// The close (content.ts, contact): a short line, the invitation set large, then the email in large type and
// WhatsApp and Instagram when they are filled in. Addresses and handles read left to right inside the Arabic text.
// It rises line by line as it scrolls in; a hovered link redraws its underline.
import { visuals } from '../content';
const { kicker, heading, email, whatsapp, whatsappLabel, instagram, instagramLabel } = visuals.contact;
---
<section id="contact" aria-labelledby="contact-heading">
  <p class="kicker" data-reveal="rise">{kicker}</p>
  <h2 id="contact-heading" data-reveal="rise" style="--i: 1; --rise: 0.3em">{heading}</h2>
  <ul data-reveal="rise" style="--i: 3">
    <li><a href={`mailto:${email}`} dir="ltr">{email}</a></li>
    {whatsapp && <li><a href={`https://wa.me/${whatsapp}`}>{whatsappLabel} ←</a></li>}
    {instagram && <li><a href={`https://www.instagram.com/${instagram}/`}>{instagramLabel} ←</a></li>}
  </ul>
</section>

<style>
  section { padding: 48px var(--gutter); border-bottom: 1px solid var(--line); }
  .kicker { font-size: 13px; line-height: 18px; color: var(--muted); }
  h2 { margin-top: 12px; font-size: 56px; line-height: 64px; font-weight: 300; }
  ul { display: flex; flex-direction: column; align-items: flex-start; gap: 4px; margin: 16px 0 0; padding: 0; list-style: none; }
  /* The underline is a 1px background, so a hover can draw it again from the start of the line. */
  a {
    display: inline-block;
    padding-block: 8px;
    font-size: 20px;
    line-height: 28px;
    text-decoration: none;
    background: linear-gradient(currentColor, currentColor) right bottom 6px / 100% 1px no-repeat;
  }
  @media (prefers-reduced-motion: no-preference) {
    a:hover { animation: redraw 0.8s var(--ease); }
  }
  @keyframes redraw { from { background-size: 0 1px; } }

  @media (min-width: 720px) {
    section { padding-block: 96px; }
    .kicker { font-size: 15px; line-height: 22px; }
    h2 { font-size: clamp(5rem, 9vw, 9rem); line-height: 1.1; }
    ul { margin-top: 32px; }
    a { font-size: 32px; line-height: 44px; }
  }
</style>
