---
// The photos (content.ts, photos): one column on phones, two on tablets, three on wide screens.
import { cloudinarySrcSet, cloudinaryUrl } from '../../lib/cloudinary';
import { visuals } from '../content';
const { heading, items } = visuals.photos;
---
{items.length > 0 && (
  <section class="section" aria-labelledby="photos-heading">
    <h2 id="photos-heading">{heading}</h2>
    <ul>
      {items.map((photo) => (
        <li>
          <img
            src={cloudinaryUrl(photo.id, 1024)}
            srcset={cloudinarySrcSet(photo.id)}
            sizes="(min-width: 960px) 33vw, (min-width: 600px) 50vw, 100vw"
            alt={photo.alt}
            loading="lazy"
            decoding="async"
          />
        </li>
      ))}
    </ul>
  </section>
)}

<style>
  ul { list-style: none; margin: 0; padding: 0; display: grid; gap: var(--gap); }
  img { width: 100%; }
  @media (min-width: 600px) { ul { grid-template-columns: repeat(2, 1fr); } }
  @media (min-width: 960px) { ul { grid-template-columns: repeat(3, 1fr); } }
</style>
