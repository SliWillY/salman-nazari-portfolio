---
// The videos (content.ts, videos): one column on phones, two from tablets up. Only the posters load with the page;
// a video loads when it is played.
import { cloudinaryUrl, cloudinaryVideoPoster, cloudinaryVideoUrl } from '../../lib/cloudinary';
import { visuals } from '../content';
const { heading, items } = visuals.videos;
---
{items.length > 0 && (
  <section class="section" aria-labelledby="videos-heading">
    <h2 id="videos-heading">{heading}</h2>
    <ul>
      {items.map((video) => (
        <li>
          <video
            src={cloudinaryVideoUrl(video.id)}
            poster={video.poster ? cloudinaryUrl(video.poster, 960) : cloudinaryVideoPoster(video.id)}
            aria-label={video.title}
            controls
            playsinline
            preload="none"
          ></video>
        </li>
      ))}
    </ul>
  </section>
)}

<style>
  ul { list-style: none; margin: 0; padding: 0; display: grid; gap: var(--gap); }
  video { width: 100%; }
  @media (min-width: 600px) { ul { grid-template-columns: repeat(2, 1fr); } }
</style>
