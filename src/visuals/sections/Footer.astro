---
// The thin bar at the bottom, mirroring the header: the name, what this is, and the year.
import { visuals } from '../content';
---
<footer>
  <span class="name"><span class="mark" aria-hidden="true"></span>{visuals.header.name}</span>
  <span>{visuals.header.tagline}</span>
  <span dir="ltr">©{new Date().getFullYear()}</span>
</footer>

<style>
  footer {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 16px;
    height: 44px;
    padding: 0 var(--gutter);
    font-size: 12px;
    line-height: 16px;
  }
  .name { display: flex; align-items: center; gap: 6px; }
  .mark { width: 8px; height: 8px; background: var(--ink); }

</style>
