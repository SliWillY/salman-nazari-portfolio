---
// How a shoot runs (content.ts, process): each step a big light number and its name. Rows on phones, four columns
// on wide screens, where the column lines grow down as it scrolls in. The numbers rise one after another.
import SectionHead from '../components/SectionHead.astro';
import { visuals } from '../content';
const { heading, steps } = visuals.process;
---
<section aria-labelledby="process-heading">
  <SectionHead id="process-heading" heading={heading} count={String(steps.length).padStart(2, '0')} />
  <ol data-lines>
    {steps.map((step, i) => (
      <li>
        <span class="number" dir="ltr" data-reveal="rise" style={`--i: ${i * 2}; --rise: 0.4em`}>{String(i + 1).padStart(2, '0')}</span>
        <span class="step" data-reveal="rise" style={`--i: ${i * 2 + 1}`}>{step}</span>
      </li>
    ))}
  </ol>
</section>

<style>
  ol { margin: 0; padding: 0; list-style: none; }
  li {
    display: flex;
    align-items: flex-end;
    justify-content: space-between;
    padding: 12px var(--gutter) 14px;
    border-bottom: 1px solid var(--line);
  }
  .number { font-size: 60px; line-height: 64px; font-weight: 300; }
  .step { font-size: 14px; line-height: 20px; font-weight: 500; }

  @media (min-width: 720px) {
    ol {
      display: grid;
      grid-template-columns: repeat(4, minmax(0, 1fr));
      border-bottom: 1px solid var(--line);
      background:
        linear-gradient(var(--line), var(--line)) 25% 0 / 1px 100% no-repeat,
        linear-gradient(var(--line), var(--line)) 50% 0 / 1px 100% no-repeat,
        linear-gradient(var(--line), var(--line)) 75% 0 / 1px 100% no-repeat;
    }
    li { flex-direction: column; align-items: flex-start; gap: 48px; padding: 16px var(--gutter) 20px; border-bottom: 0; }
    .number { font-size: 96px; line-height: 100px; }
    .step { font-size: 16px; line-height: 24px; }
  }
</style>
