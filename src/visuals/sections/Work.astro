---
// The photos, grouped by style (content.ts, work). Each group: a label/value row, then its photos in columns split by
// hairlines: two on phones (the first half of the group in one column, the rest in the other), four on wide screens.
import Photo from '../components/Photo.astro';
import SectionHead from '../components/SectionHead.astro';
import { visuals } from '../content';
const { heading, groupLabel, groups } = visuals.work;
const total = groups.reduce((sum, group) => sum + group.photos.length, 0);
const halves = (photos: typeof groups[number]['photos']) => {
  const half = Math.ceil(photos.length / 2);
  return [photos.slice(0, half), photos.slice(half)];
};
---
<section id="work" aria-labelledby="work-heading">
  <SectionHead id="work-heading" heading={heading} count={String(total).padStart(2, '0')} />
  {groups.map((group) => (
    <div>
      <div class="meta">
        <span class="label">{groupLabel}</span>
        <h3>{group.name}</h3>
        <p>{group.description}</p>
      </div>
      <div class="photos">
        {halves(group.photos).map((column) => (
          <div class="column">
            {column.map((photo) => (
              <div class="cell"><Photo photo={photo} ratio={photo.ratio} sizes="(min-width: 720px) 25vw, 50vw" /></div>
            ))}
          </div>
        ))}
      </div>
    </div>
  ))}
</section>

<style>
  .meta {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    grid-template-areas: "label name" "label text";
    padding: 12px var(--gutter);
    border-bottom: 1px solid var(--line);
  }
  .label { grid-area: label; font-size: 12px; line-height: 20px; color: var(--muted); }
  h3 { grid-area: name; font-size: 14px; line-height: 20px; font-weight: 500; }
  .meta p { grid-area: text; font-size: 12px; line-height: 18px; color: var(--muted); }

  /* Column hairlines are 1px backgrounds on the grid, so they run its full height whatever the photos' heights. */
  .photos {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    border-bottom: 1px solid var(--line);
    background: linear-gradient(var(--line), var(--line)) 50% 0 / 1px 100% no-repeat;
  }
  .column { display: flex; flex-direction: column; gap: 8px; padding: 8px; }

  @media (min-width: 720px) {
    .meta { grid-template-columns: 1fr 1fr 2fr; grid-template-areas: "label name text"; padding-block: 16px; }
    h3 { font-size: 16px; line-height: 24px; }
    .meta p { font-size: 14px; line-height: 24px; }

    /* Four columns: the halves dissolve and every photo takes its own column, top-aligned, so mixed ratios stagger. */
    .photos {
      grid-template-columns: repeat(4, minmax(0, 1fr));
      background:
        linear-gradient(var(--line), var(--line)) 25% 0 / 1px 100% no-repeat,
        linear-gradient(var(--line), var(--line)) 50% 0 / 1px 100% no-repeat,
        linear-gradient(var(--line), var(--line)) 75% 0 / 1px 100% no-repeat;
    }
    .column { display: contents; }
    .cell { padding: 12px; }
  }
</style>
