---
// What a brand receives (content.ts, deliverables), right before the contact: label and value rows over hairlines,
// the same pairing as the work's group rows. Half and half on phones; on wide screens the label takes the first
// column and the value the other three. The rows rise one after another as they scroll in.
import SectionHead from '../components/SectionHead.astro';
import { visuals } from '../content';
const { heading, items } = visuals.deliverables;
---
<section aria-labelledby="deliverables-heading">
  <SectionHead id="deliverables-heading" heading={heading} count={String(items.length).padStart(2, '0')} />
  <dl>
    {items.map((item, i) => (
      <div data-reveal="rise" style={`--i: ${i}`}>
        <dt>{item.label}</dt>
        <dd>{item.value}</dd>
      </div>
    ))}
  </dl>
</section>

<style>
  dl { margin: 0; }
  div {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    padding: 12px var(--gutter);
    border-bottom: 1px solid var(--line);
  }
  dt { font-size: 12px; line-height: 20px; color: var(--muted); }
  dd { margin: 0; font-size: 14px; line-height: 20px; font-weight: 500; }

  @media (min-width: 720px) {
    div { grid-template-columns: 1fr 3fr; padding-block: 16px; }
    dt { font-size: 14px; line-height: 24px; }
    dd { font-size: 16px; line-height: 24px; }
  }
</style>
