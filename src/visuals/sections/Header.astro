---
// The thin bar at the top: the name, what this is, and a jump to the contact section (content.ts, header).
import { visuals } from '../content';
const { name, tagline, contact } = visuals.header;
---
<header>
  <span class="name"><span class="mark" aria-hidden="true"></span>{name}</span>
  <span>{tagline}</span>
  <a href="#contact">{contact}</a>
</header>

<style>
  header {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 16px;
    height: 44px;
    padding: 0 var(--gutter);
    border-bottom: 1px solid var(--line);
    font-size: 11px;
    line-height: 16px;
  }
  .name { display: flex; align-items: center; gap: 6px; }
  .mark { width: 8px; height: 8px; background: var(--ink); }
  a { display: flex; align-items: center; align-self: stretch; text-decoration: none; }
  a:hover { text-decoration: underline; }

  @media (min-width: 720px) {
    header { font-size: 12px; }
  }
</style>
