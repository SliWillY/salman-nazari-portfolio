---
// The thin bar at the top: the name, what this is, and a jump to the contact section (content.ts, header). The jump
// is underlined at rest, so it reads as the one link in the bar; a hover draws the underline again.
import { visuals } from '../content';
const { name, tagline, contact } = visuals.header;
---
<header>
  <span class="name"><span class="mark" aria-hidden="true"></span>{name}</span>
  <span>{tagline}</span>
  <a href="#contact">{contact}</a>
</header>

<style>
  header {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 16px;
    height: 44px;
    padding: 0 var(--gutter);
    border-bottom: 1px solid var(--line);
    font-size: 12px;
    line-height: 16px;
  }
  .name { display: flex; align-items: center; gap: 6px; }
  .mark { width: 8px; height: 8px; background: var(--ink); }
  /* The padding widens the tap area past the short word; the underline stays under the word itself. */
  a {
    display: flex;
    align-items: center;
    align-self: stretch;
    margin-inline: -12px;
    padding-inline: 12px;
    text-decoration: none;
    background: linear-gradient(currentColor, currentColor) right calc(50% + 10px) / 100% 1px no-repeat;
    background-origin: content-box;
    background-clip: content-box;
  }
  @media (prefers-reduced-motion: no-preference) {
    a:is(:hover, :focus-visible) { animation: redraw 0.8s var(--ease); }
  }
  @keyframes redraw { from { background-size: 0 1px; } }

</style>
