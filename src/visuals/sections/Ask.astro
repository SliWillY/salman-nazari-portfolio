---
// A short ask in the middle of the page (content.ts, ask), after the angles: one line beside the same black call to
// action as the opening (its words come from the hero, so the two always match), jumping to the contact section.
// Two cells in a row, split by a hairline. It rises as it scrolls in.
import { visuals } from '../content';
const { line } = visuals.ask;
const { cta } = visuals.hero;
---
<div class="ask">
  <p data-reveal="rise">{line}</p>
  <a href="#contact" data-reveal="rise" style="--i: 1"><span>{cta}</span><svg width="18" height="18" viewBox="0 0 20 20" fill="none" stroke="currentColor" stroke-width="1.5" aria-hidden="true"><path d="M17 10H3M9 4l-6 6 6 6" /></svg></a>
</div>

<style>
  .ask { display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); border-bottom: 1px solid var(--line); }
  p { align-self: center; padding: 14px var(--gutter); font-size: 13px; line-height: 20px; }
  a {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 12px;
    min-height: 52px;
    padding: 0 var(--gutter);
    background: var(--ink);
    color: var(--ground);
    font-size: 15px;
    line-height: 22px;
    font-weight: 500;
    text-decoration: none;
  }
  /* The cell runs to the screen's edge, so its focus ring sits inside it, in the ground colour. */
  a:focus-visible { outline-color: var(--ground); outline-offset: -6px; }
  @media (prefers-reduced-motion: no-preference) {
    svg { transition: transform 0.5s var(--ease); }
    a:is(:hover, :focus-visible) svg { transform: translateX(-6px); }
  }

  /* Wide screens: the line takes three of the four columns, the call to action the last one. */
  @media (min-width: 720px) {
    .ask { grid-template-columns: 3fr 1fr; }
    p { font-size: 15px; line-height: 22px; }
    a { min-height: 64px; font-size: 16px; line-height: 24px; }
  }
</style>
