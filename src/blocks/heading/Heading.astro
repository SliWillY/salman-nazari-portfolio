---
import { t } from '../../lib/i18n';
const { block, lang } = Astro.props;
const Tag = `h${block.level}`;
const size = block.size ?? ({ 1: 'xl', 2: 'l', 3: 'm' } as Record<number, string>)[block.level];
---
<div class:list={['b-heading', `size-${size}`, block.align && `align-${block.align}`]}>
  {block.eyebrow && <span class="eyebrow">{t(block.eyebrow, lang)}</span>}
  <Tag>{t(block.text, lang)}</Tag>
</div>
