---
// Page hero. `size: home` is the headline on the home stage. `size: page` puts a banner at the top of the page
// (tall with floating toys on a world's own page; medium on About and Certificates and a slim strip on projects,
// both with confetti only) and, under it, the big title beside its description, with a superscript number: the
// page's number (About⁰⁰, UX⁰¹…) or a project's year.
import Banner from '../../components/Banner.astro';
import { t } from '../../lib/i18n';
import { categoryHue, pageNumber } from '../../lib/site';
const { block, lang, ctx } = Astro.props;
const eyebrow = t(block.eyebrow ?? ctx.eyebrow, lang);
const title = t(block.title ?? ctx.title, lang);
const intro = t(block.intro ?? ctx.description, lang);
const eyebrowHref = block.eyebrow ? undefined : ctx.eyebrowHref;
const world = ctx.category ? undefined : categoryHue[ctx.route];
const number = ctx.category ? (ctx.project?.year ? String(ctx.project.year) : '') : pageNumber(ctx.route);
const bannerSize = world ? 'tall' : ['about-me', 'certificates'].includes(ctx.route) ? 'medium' : 'slim';
// On a world's own page (and About, in the site's orange dot) the title is led by its shape, glued to the first
// word so it never wraps alone.
const shape = !!world || ctx.route === 'about-me';
const space = title.indexOf(' ');
const [lead, rest] = space < 0 ? [title, ''] : [title.slice(0, space), title.slice(space)];
---
{block.size === 'home' ? (
  <header class="b-hero size-home">
    {/* The greeting, word by word, so each word can hop in on its own (whole words, so Arabic stays joined). */}
    {eyebrow && <span class="eyebrow">{eyebrow.split(' ').map((word, k) => <span class="hi-word" style={`--k: ${k}`}>{word}</span>)}</span>}
    <h1>{title}</h1>
    {intro && <p>{intro}</p>}
  </header>
) : (
  <header class="b-hero size-page">
    <Banner world={world} size={bannerSize} eyebrow={eyebrow} eyebrowHref={eyebrowHref} />
    <div class="hero-intro">
      <h1>{shape ? <Fragment><span class="title-lead"><span class="world-shape" aria-hidden="true"></span>{lead}</span>{rest}</Fragment> : title}{number && <sup class="hero-num">{number}</sup>}</h1>
      {intro && <p class="hero-lede">{intro}</p>}
    </div>
  </header>
)}
