---
import { t } from '../../lib/i18n';
const { block, lang, ctx } = Astro.props;
const eyebrow = t(block.eyebrow ?? ctx.eyebrow, lang);
const title = t(block.title ?? ctx.title, lang);
const intro = t(block.intro ?? ctx.description, lang);
const eyebrowHref = block.eyebrow ? undefined : ctx.eyebrowHref;
---
<header class:list={['b-hero', `size-${block.size}`]}>
  {eyebrow && (eyebrowHref ? <a class="eyebrow" href={eyebrowHref}>{eyebrow}</a> : <span class="eyebrow">{eyebrow}</span>)}
  <h1>{title}</h1>
  {intro && <p>{intro}</p>}
</header>
