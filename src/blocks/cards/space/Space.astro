---
// Cards `layout: space`: the home scene. The worlds are scattered down a sun-gradient stage full of floating
// Cinema 4D-style toys (src/lib/toys/). Hover / focus a world and its own toys spring onto the stage beside it and
// act out its story; on touch screens the world nearest the middle of the screen plays. Each world takes its colour
// from its icon (.hue-*). The toys paint over the whole section, so keep the hero in the same section.
// three.js loads after the page has painted, so the words are there first. Styles: global.css, "home scene".
import { t } from '../../../lib/i18n';
import { href, iconHue, type Lang } from '../../../lib/site';
const { items, lang, uid } = Astro.props as { items: any[]; lang: Lang; uid: string };
const explore = lang === 'ar' ? 'استكشف' : 'Explore';
const arrow = lang === 'ar' ? '↖' : '↗';
---
<div class="b-space" data-space>
  <canvas class="space-canvas" aria-hidden="true"></canvas>
  <ul class="space-list" role="list">
    {items.map((item, i) => {
      const external = /^https?:/.test(item.href);
      const id = `${uid}-${i}`;
      const hue = item.icon && iconHue[item.icon as keyof typeof iconHue];
      // Words wave one after another on hover (word by word, so Arabic letters stay joined).
      const words = t(item.title, lang).split(' ');
      return (
        <li class:list={['space-item', hue && `hue-${hue}`]}>
          <a class="space-link" href={href(item.href, lang)} target={external ? '_blank' : undefined} rel={external ? 'noreferrer' : undefined} data-icon={item.icon} aria-labelledby={`${id}-title`} aria-describedby={item.text ? `${id}-text` : undefined}>
            {/* The world's shape leads, glued to the first word; the number follows the last word with no space between. */}
            <h3 class="space-title" id={`${id}-title`}>
              {words.map((word: string, k: number) => {
                const w = <span class="space-word" style={`--k: ${k}`}>{word}</span>;
                return <Fragment>{k === 0 ? <span class="title-lead"><span class="world-shape" aria-hidden="true"></span>{w}</span> : w}{k < words.length - 1 && ' '}</Fragment>;
              })}<sup class="space-num" aria-hidden="true">{String(i + 1).padStart(2, '0')}</sup>
            </h3>
            {item.text && <p class="space-text" id={`${id}-text`}>{t(item.text, lang)}</p>}
            <span class="space-cta" aria-hidden="true">{t(item.cta, lang) || explore} <span class="feature-arrow">{arrow}</span></span>
            {item.icon && <span class="space-stage" aria-hidden="true"></span>}
          </a>
        </li>
      );
    })}
  </ul>
</div>

<script>
  // Toys that only float in the scene (the worlds bring their own). Fewer on phones.
  const FLOAT_LARGE = ['eyeball', 'worm', 'candycorn', 'striped', 'coil', 'bubbles', 'gem', 'cross', 'donut'] as const;
  const FLOAT_SMALL = ['eyeball', 'worm', 'candycorn', 'bubbles', 'coil'] as const;
  const spaces = document.querySelectorAll<HTMLElement>('[data-space]');
  async function start() {
    const [{ mountToys }, { stories }] = await Promise.all([import('../../../lib/toys/engine'), import('../../../lib/toys/stories')]);
    const small = matchMedia('(max-width: 700px)').matches;
    for (const space of spaces) {
      const section = space.closest<HTMLElement>('.section') ?? space;
      const worlds = [...space.querySelectorAll<HTMLAnchorElement>('.space-link[data-icon]')].flatMap((link) => {
        const story = stories[link.dataset.icon ?? ''];
        const stage = link.querySelector<HTMLElement>('.space-stage');
        return story && stage ? [{ link, stage, story }] : [];
      });
      mountToys(section, space.querySelector('canvas')!, {
        worlds,
        float: (small ? FLOAT_SMALL : FLOAT_LARGE).map((kind) => ({ kind })),
        confetti: small ? 12 : 26,
        avoid: () => [...section.querySelectorAll('.b-hero .eyebrow, .b-hero h1, .b-hero p,.b-heading, .space-title, .space-text, .space-cta')]
      });
    }
  }
  // The 3D cube tumbles while pointed at, in loops (global.css, cube-tumble). Leaving mid-tumble would snap it back,
  // so .is-looping is on from the moment it's pointed at and only comes off once a loop has ended after the pointer
  // (or focus) has left: the end of each loop is the cube's resting pose.
  for (const shape of document.querySelectorAll<HTMLElement>('.space-item.hue-3d .world-shape')) {
    const link = shape.closest<HTMLElement>('.space-link')!;
    let leaving = false;
    const start = () => { leaving = false; link.classList.add('is-looping'); };
    const finish = () => { leaving = true; };
    link.addEventListener('pointerenter', start);
    link.addEventListener('focusin', start);
    link.addEventListener('pointerleave', finish);
    link.addEventListener('focusout', finish);
    shape.addEventListener('animationiteration', () => { if (leaving) link.classList.remove('is-looping'); });
  }

  // The Games d-pad turns into an X while pointed at (CSS), and then takes a hit every second at a random spot: the
  // outline swells out from that spot like a fish-eye lens and springs back with a little rubbery wobble. A mask
  // can't bend, so the shape is redrawn as a live outline of points (from the same --hue-shape path), each pushed
  // away from the hit, most near it and fading with distance. On leaving, the last hit settles and the crisp
  // original path comes back. Still with reduced motion.
  const POINTS = 240; // outline samples
  const REACH = 7; // how far a hit spreads (in the shape's 24-unit box)
  const HIT_EVERY = 1000, FIRST_HIT = 600; // ms; the first waits for the turn into an X
  const swell = (t: number) => (t < 0.06 ? Math.sin((t / 0.06) * Math.PI / 2) : Math.exp(-(t - 0.06) / 0.16) * Math.cos(((t - 0.06) * 2 * Math.PI) / 0.5)); // quick hit, damped wobble
  if (!matchMedia('(prefers-reduced-motion: reduce)').matches) {
    for (const shape of document.querySelectorAll<HTMLElement>('.space-item.hue-games .world-shape')) {
      const d = getComputedStyle(shape).getPropertyValue('--hue-shape').match(/d='([^']+)'/)?.[1];
      const link = shape.closest<HTMLElement>('.space-link');
      if (!d || !link) continue;
      const svg = document.createElementNS('http://www.w3.org/2000/svg', 'svg');
      const path = document.createElementNS('http://www.w3.org/2000/svg', 'path');
      svg.setAttribute('viewBox', '0 0 24 24');
      path.setAttribute('d', d);
      svg.append(path);
      shape.append(svg);
      shape.classList.add('is-drawn');
      const length = path.getTotalLength();
      const outline = Array.from({ length: POINTS }, (_, i) => path.getPointAtLength((length * i) / POINTS)).map((p) => [p.x, p.y]);
      let hits: { x: number; y: number; at: number; power: number }[] = [];
      let running = false;
      let nextHit = 0;
      const on = () => link.matches(':hover, :focus-visible, .is-active');
      const frame = (now: number) => {
        if (on() && now >= nextHit) {
          // A random spot on the pad: a point of the outline, pulled part way in towards the middle.
          const [ox, oy] = outline[Math.floor(Math.random() * POINTS)];
          const inward = 0.15 + Math.random() * 0.3;
          hits.push({ x: ox + (12 - ox) * inward, y: oy + (12 - oy) * inward, at: now, power: 0.9 + Math.random() * 0.45 });
          nextHit = now + HIT_EVERY;
        }
        hits = hits.filter((hit) => now - hit.at < 1400);
        if (!hits.length && !on()) { path.setAttribute('d', d); running = false; return; }
        const bent = outline.map(([x, y]) => {
          let dx = 0, dy = 0;
          for (const hit of hits) {
            const vx = x - hit.x, vy = y - hit.y;
            const push = hit.power * swell((now - hit.at) / 1000) * Math.exp(-(vx * vx + vy * vy) / (REACH * REACH));
            dx += vx * push; dy += vy * push;
          }
          return `${(x + dx).toFixed(2)} ${(y + dy).toFixed(2)}`;
        });
        path.setAttribute('d', `M${bent.join('L')}Z`);
        requestAnimationFrame(frame);
      };
      const start = () => {
        if (running || !on()) return;
        running = true;
        nextHit = performance.now() + FIRST_HIT;
        requestAnimationFrame(frame);
      };
      link.addEventListener('pointerenter', () => requestAnimationFrame(start));
      link.addEventListener('focusin', () => requestAnimationFrame(start));
      new MutationObserver(start).observe(link, { attributes: true, attributeFilter: ['class'] }); // .is-active on phones
    }
  }

  // After first paint: the toys never hold up the words.
  if (spaces.length) {
    if ('requestIdleCallback' in window) requestIdleCallback(() => start(), { timeout: 700 });
    else setTimeout(start, 250);
  }
</script>
